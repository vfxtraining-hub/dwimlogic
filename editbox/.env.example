# The Edit Box live server. Copy to editbox/.env and fill in. Real environment variables override this file.

# --- core ---
PORT=8787
EDITBOX_BASE_URL=http://localhost:8787
# Comma-separated editor (studio) accounts. Everyone else who signs in is a client.
EDITBOX_ADMIN_EMAILS=you@example.com
# Where db.json and local uploads live. Back this directory up.
EDITBOX_DATA_DIR=./data
# NODE_ENV=production

# --- sign-in email (magic links + notifications) ---
# Without RESEND_API_KEY, outside production, sign-in links are shown on screen (dev only).
RESEND_API_KEY=
EDITBOX_MAIL_FROM=The Edit Box <editbox@dwimlogic.com>
# EDITBOX_DEV_LOGIN=1

# --- payments (Stripe Checkout) ---
# Without STRIPE_SECRET_KEY the server runs a labelled mock checkout that charges nothing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: a recurring Price for the archive subscription. Otherwise one is created inline from PRICING.archive.
STRIPE_ARCHIVE_PRICE_ID=

# --- storage ---
# local (default) or s3. s3 works with AWS S3, Cloudflare R2, Backblaze B2 and other S3-compatible stores.
EDITBOX_STORAGE=local
S3_BUCKET=
S3_REGION=auto
# R2 example: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=1
EDITBOX_MAX_UPLOAD_MB=51200

# --- editing agents (Grok Bot, Cursor agents) ---
# name:secret pairs. Secrets at least 16 characters. Agents call the API with Authorization: Bearer <secret>.
EDITBOX_AGENT_KEYS=grok-bot:change-me-to-a-long-random-string

# --- retention ---
# How often the in-process retention job runs. 0 disables it (then schedule `npm run retention`).
EDITBOX_RETENTION_INTERVAL_HOURS=6
